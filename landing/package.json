{
  "name": "awesome-rag-production-landing",
  "private": true,
  "type": "module",
  "description": "Animated landing page for Awesome RAG Production (served at / on GitHub Pages; the mkdocs list lives under /docs/).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "stats": "node ./scripts/run-stats.mjs",
    "predev": "npm run stats",
    "dev": "astro dev",
    "prebuild": "npm run stats",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run stats -- --no-history",
    "check": "astro check && tsc --noEmit && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "astro": "7.3.8",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "ogl": "1.0.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
