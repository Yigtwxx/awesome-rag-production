---
import { catalog } from '../lib/catalog';
import { docsHref } from '../lib/site';

// Same fixed tag order and validated colours as the scene.
const TAGS: Record<string, { name: string; color: string }> = {
  '3P': { name: 'Third-party', color: '#3987e5' },
  V: { name: 'Vendor', color: '#d95926' },
  A: { name: 'Author', color: '#199e70' },
};
const claims = catalog.claims;
const groups = catalog.pitfalls;
---

<section
  class="chapter evidence-chapter"
  aria-labelledby="evidence-chapter-title"
>
  <div class="container">
    <header class="chapter__head">
      <h2 id="evidence-chapter-title" class="chapter__title">
        Every claim,
        <span class="serif tone-coral">every fix.</span>
      </h2>
      <p class="chapter__lede">
        The full ledger behind the scene above: each benchmark number with who
        measured it and where, and every pitfall with a link to its fix.
      </p>
    </header>

    <div class="evidence-chapter__cols">
      <div>
        <h3 class="evidence-chapter__sub reveal">
          Benchmark claims <span class="mono">{claims.length}</span>
        </h3>
        <ul class="evidence-chapter__list">
          {claims.map((c) => {
            const tag = TAGS[c.tag] ?? { name: c.tag, color: '#7d8796' };
            return (
              <li class="reveal">
                <a href={docsHref('benchmarks/')}>
                  <span
                    class="evidence-chapter__tag mono"
                    style={`color:${tag.color}`}
                  >
                    <span class="swatch" style={`background:${tag.color}`} />
                    {c.tag}
                  </span>
                  <span class="evidence-chapter__what">
                    <strong>{c.subject}</strong>
                    <span>{c.detail}</span>
                  </span>
                  <span class="evidence-chapter__source mono">
                    {c.source || tag.name.toLowerCase()}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <h3 class="evidence-chapter__sub reveal">
          Pitfalls{' '}
          <span class="mono">{groups.reduce((n, g) => n + g.count, 0)}</span>
        </h3>
        {groups.map((group) => (
          <div class="evidence-chapter__group reveal">
            <p class="evidence-chapter__section mono">{group.section}</p>
            <ul class="evidence-chapter__list">
              {group.items.map((item) => (
                <li>
                  <a href={docsHref('rag-pitfalls/', item.anchor)}>
                    <span class="evidence-chapter__x" aria-hidden="true">
                      ✕
                    </span>
                    <span class="evidence-chapter__what">
                      <strong>{item.title}</strong>
                    </span>
                    <span class="evidence-chapter__source mono">
                      Read the fix
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .evidence-chapter__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem clamp(2rem, 5vw, 5rem);
  }

  .evidence-chapter__sub {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
  }

  .evidence-chapter__sub .mono {
    color: var(--mist);
  }

  .evidence-chapter__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence-chapter__list a {
    position: relative;
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .evidence-chapter__list a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, var(--ice), transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .evidence-chapter__list a:hover::after {
    transform: scaleX(1);
  }

  .evidence-chapter__what {
    display: grid;
    gap: 0.15rem;
  }

  .evidence-chapter__what strong {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .evidence-chapter__what span {
    color: var(--mist);
    font-size: 0.88rem;
  }

  .evidence-chapter__source {
    color: var(--dim);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .evidence-chapter__list a:hover .evidence-chapter__source {
    color: var(--ice);
  }

  .evidence-chapter__x {
    color: var(--coral);
  }

  .evidence-chapter__group + .evidence-chapter__group {
    margin-top: 1.6rem;
  }

  .evidence-chapter__section {
    margin-bottom: 0.2rem;
    color: var(--dim);
  }

  @media (max-width: 60rem) {
    .evidence-chapter__cols {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { fadeSceneUnder, revealOnScroll, revealTitles } from '../lib/motion';

  fadeSceneUnder('.evidence-chapter');

  revealTitles('.evidence-chapter .chapter__title');
  revealOnScroll('.evidence-chapter .reveal');
</script>
