---
import { catalog } from '../lib/catalog';
import { docsHref } from '../lib/site';

// Evidence tags: dataviz categorical slots 1-3, validated all-pairs on the
// dark surface. Order is fixed: third-party, vendor, author.
const TAGS = [
  {
    tag: '3P',
    name: 'Third-party',
    meaning: 'measured by an independent party',
    color: '#3987e5',
  },
  {
    tag: 'V',
    name: 'Vendor',
    meaning: 'published by the vendor itself',
    color: '#d95926',
  },
  {
    tag: 'A',
    name: 'Author',
    meaning: 'reported by the team that built it',
    color: '#199e70',
  },
];
const claims = catalog.claims.map((c) => ({
  ...c,
  orbit: Math.max(
    0,
    TAGS.findIndex((t) => t.tag === c.tag),
  ),
}));
const pitfalls = catalog.pitfalls.flatMap((group) =>
  group.items.map((item) => ({ ...item, section: group.section })),
);
const payload = {
  tags: TAGS,
  claims,
  pitfalls,
  pitfallsBase: docsHref('rag-pitfalls/'),
};
const counts = TAGS.map((t) => claims.filter((c) => c.tag === t.tag).length);
---

<section class="scene evidence" aria-labelledby="evidence-title">
  <canvas class="scene__canvas" aria-hidden="true"></canvas>
  <div class="scene__labels" aria-hidden="true">
    <span class="scene-label is-top evidence__label" hidden></span>
  </div>

  <div class="scene__layout">
    <div class="scene__copy">
      <h1 id="evidence-title" class="scene__title">
        Numbers with receipts.
        <span class="serif tone-coral">Mistakes with fixes.</span>
      </h1>
      <p class="scene__lede mono">
        Every benchmark number in the list carries a tag for who measured it,
        and unbacked numbers were removed. The pitfalls guide pairs each common
        failure with its fix.
      </p>

      <div class="evidence__modes" role="tablist" aria-label="Evidence view">
        <button
          class="evidence__mode brackets"
          type="button"
          role="tab"
          aria-selected="true"
          data-mode="0"
        >
          <span class="evidence__mode-num">{claims.length}</span>
          <span>Benchmark claims</span>
        </button>
        <button
          class="evidence__mode brackets"
          type="button"
          role="tab"
          aria-selected="false"
          data-mode="1"
        >
          <span class="evidence__mode-num tone-coral">{pitfalls.length}</span>
          <span>Pitfalls</span>
        </button>
      </div>

      <ul class="legend evidence__legend">
        {TAGS.map((t, i) => (
          <li>
            <i style={`background:${t.color}`} />
            {t.tag} {t.name.toLowerCase()} ({counts[i]})
          </li>
        ))}
      </ul>
    </div>

    <p class="scene__note mono">
      Each moon is one claim; its orbit is who measured it. Switch to pitfalls
      to see what breaks in production.
    </p>

    <div class="scene__panel hud evidence__panel">
      <p class="scene__counter">
        <span class="evidence__current">01</span>
        <small>
          /
          <span class="evidence__total">
            {String(claims.length).padStart(2, '0')}
          </span>
        </small>
      </p>
      <div class="scene__rule evidence__detail" aria-live="polite">
        <p class="evidence__kicker mono"></p>
        <h2 class="evidence__title"></h2>
        <p class="evidence__meta mono"></p>
        <a class="evidence__link mono" href={docsHref('benchmarks/')}>
          Methodology and source
        </a>
      </div>
      <div class="evidence__nav">
        <button
          class="scene-btn brackets"
          type="button"
          data-step="-1"
          aria-label="Previous item"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M13 8H4m0 0l3.5-3.5M4 8l3.5 3.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
        <button
          class="scene-btn brackets"
          type="button"
          data-step="1"
          aria-label="Next item"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
        <span class="evidence__progress" aria-hidden="true">
          <i></i>
        </span>
      </div>
    </div>
  </div>

  <script
    type="application/json"
    class="evidence__data"
    set:html={JSON.stringify(payload)}
  />
</section>

<style>
  .evidence__modes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .evidence__mode {
    --bracket: transparent;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: rgb(3 8 23 / 0.55);
    color: var(--mist);
    font: 500 0.92rem var(--font-sans);
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .evidence__mode[aria-selected='true'] {
    --bracket: var(--chalk);
    background: rgb(10 29 69 / 0.75);
    color: var(--chalk);
  }

  .evidence__mode-num {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .evidence__legend {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.2rem;
    transition: opacity 300ms ease;
  }

  .evidence__legend.is-hidden {
    opacity: 0.25;
  }

  .evidence__detail {
    min-height: 9.5rem;
  }

  .evidence__kicker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--mist);
  }

  .evidence__kicker :global(i) {
    width: 9px;
    height: 9px;
    border-radius: 2px;
  }

  .evidence__title {
    margin-top: 0.4rem;
    font-size: var(--step-1);
  }

  .evidence__meta {
    margin-top: 0.4rem;
    color: var(--mist);
  }

  .evidence__link {
    display: inline-block;
    margin-top: 0.6rem;
    color: var(--ice);
    text-underline-offset: 0.3em;
  }

  .evidence__nav {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.2rem;
  }

  .evidence__progress {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }

  .evidence__progress i {
    position: absolute;
    inset: 0;
    background: var(--ice);
    transform: scaleX(0);
    transform-origin: left;
  }
</style>

<script>
  import { getMotion, liftText } from '../lib/motion';
  import { createOrbitScene } from '../lib/orbit-scene';
  import { createSpace } from '../lib/space';

  interface Payload {
    tags: { tag: string; name: string; meaning: string; color: string }[];
    claims: {
      subject: string;
      detail: string;
      tag: string;
      source: string;
      orbit: number;
    }[];
    pitfalls: { title: string; anchor: string; section: string }[];
    pitfallsBase: string;
  }

  const section = document.querySelector<HTMLElement>('.evidence');
  const dataEl = section?.querySelector<HTMLScriptElement>('.evidence__data');
  const canvas = section?.querySelector<HTMLCanvasElement>('.scene__canvas');

  if (section && dataEl && canvas) {
    const { gsap, ScrollTrigger, reduced } = getMotion();
    const data = JSON.parse(dataEl.textContent ?? '{}') as Payload;
    const modes = [
      ...section.querySelectorAll<HTMLButtonElement>('.evidence__mode'),
    ];
    const legend = section.querySelector<HTMLElement>('.evidence__legend')!;
    const currentEl = section.querySelector<HTMLElement>('.evidence__current')!;
    const totalEl = section.querySelector<HTMLElement>('.evidence__total')!;
    const detail = section.querySelector<HTMLElement>('.evidence__detail')!;
    const kicker = section.querySelector<HTMLElement>('.evidence__kicker')!;
    const title = section.querySelector<HTMLElement>('.evidence__title')!;
    const meta = section.querySelector<HTMLElement>('.evidence__meta')!;
    const link = section.querySelector<HTMLAnchorElement>('.evidence__link')!;
    const label = section.querySelector<HTMLElement>('.evidence__label')!;
    const progress = section.querySelector<HTMLElement>(
      '.evidence__progress i',
    )!;
    const benchmarksHref = link.href;

    const space = createSpace(canvas, { fov: 34 });
    const scene = space
      ? createOrbitScene(space, {
          claims: data.claims.map((c) => c.orbit),
          tagColors: data.tags.map((t) => t.color),
          pitfalls: data.pitfalls.length,
        })
      : undefined;
    if (!space) section.classList.add('scene--fallback');

    const place = (): void => {
      if (!space || !scene) return;
      const narrow = window.matchMedia('(max-width: 60rem)').matches;
      scene.setLayout(
        narrow ? 0 : 0.9,
        narrow ? 0.95 : 0.1,
        narrow ? 0.55 : 0.95,
      );
      space.setFocus(narrow ? 0.5 : 0.6, narrow ? 0.78 : 0.5);
    };
    place();
    window.addEventListener('resize', place);

    let mode: 0 | 1 = 0;
    let index = 0;
    const total = (): number =>
      mode === 0 ? data.claims.length : data.pitfalls.length;

    const show = (animate: boolean): void => {
      currentEl.textContent = String(index + 1).padStart(2, '0');
      totalEl.textContent = String(total()).padStart(2, '0');
      kicker.replaceChildren();
      if (mode === 0) {
        const claim = data.claims[index]!;
        const tag = data.tags[claim.orbit]!;
        const swatch = document.createElement('i');
        swatch.style.background = tag.color;
        kicker.append(
          swatch,
          `${tag.tag} ${tag.name.toLowerCase()}: ${tag.meaning}`,
        );
        title.textContent = claim.subject;
        meta.textContent = [
          claim.detail,
          claim.source && `source: ${claim.source}`,
        ]
          .filter(Boolean)
          .join('  /  ');
        link.textContent = 'Methodology and source';
        link.href = benchmarksHref;
        label.textContent = claim.subject;
      } else {
        const pit = data.pitfalls[index]!;
        kicker.append(`Anti-pattern in ${pit.section.toLowerCase()}`);
        title.textContent = pit.title;
        meta.textContent =
          'What goes wrong, why, and the fix that holds up in production.';
        link.textContent = 'Read the fix';
        link.href = `${data.pitfallsBase}#${pit.anchor}`;
        label.textContent = pit.title;
      }
      label.hidden = false;
      scene?.select(index);
      if (animate && !reduced) {
        gsap.fromTo(
          detail.children,
          { opacity: 0, y: 8 },
          { opacity: 1, y: 0, duration: 0.45, stagger: 0.05 },
        );
      }
    };

    const setMode = (next: 0 | 1): void => {
      if (next === mode) return;
      mode = next;
      index = 0;
      modes.forEach((b, i) =>
        b.setAttribute('aria-selected', String(i === next)),
      );
      legend.classList.toggle('is-hidden', next === 1);
      scene?.setMode(next);
      show(true);
      restartAutoplay();
    };

    let autoplay: gsap.core.Tween | undefined;
    let userTookOver = false;
    const restartAutoplay = (): void => {
      autoplay?.kill();
      if (reduced || userTookOver) return;
      autoplay = gsap.fromTo(
        progress,
        { scaleX: 0 },
        {
          scaleX: 1,
          duration: 5,
          ease: 'none',
          onComplete: () => {
            index = (index + 1) % total();
            show(true);
            restartAutoplay();
          },
        },
      );
    };
    const step = (delta: number): void => {
      userTookOver = true;
      autoplay?.kill();
      gsap.to(progress, { scaleX: 0, duration: 0.3 });
      index = (index + delta + total()) % total();
      show(true);
    };

    modes.forEach((button, i) =>
      button.addEventListener('click', () => {
        userTookOver = true;
        setMode(i as 0 | 1);
      }),
    );
    section
      .querySelectorAll<HTMLButtonElement>('.evidence__nav .scene-btn')
      .forEach((b) => {
        b.addEventListener('click', () => step(Number(b.dataset['step'])));
      });
    section.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') step(1);
      if (event.key === 'ArrowLeft') step(-1);
    });

    space?.onFrame(() => {
      if (!scene || label.hidden) return;
      const p = scene.anchor();
      // Keep the label on screen; hide it when its anchor leaves the canvas.
      const width = space?.width ?? window.innerWidth;
      const half = label.offsetWidth / 2;
      const offscreen = p.x < 0 || p.x > width;
      const x = Math.min(Math.max(p.x, half + 12), width - half - 12);
      label.style.visibility = p.behind || offscreen ? 'hidden' : 'visible';
      label.style.transform = `translate(${x}px, ${p.y}px) translate(-50%, -170%)`;
    });

    show(false);
    if (space) {
      if (reduced) {
        space.start(true);
      } else {
        ScrollTrigger.create({
          trigger: section.parentElement ?? section,
          start: 'top bottom',
          end: 'bottom top',
          onToggle: (self) => (self.isActive ? space.start() : space.stop()),
        });
        space.start();
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) autoplay?.pause();
          else autoplay?.resume();
        });
      }
    }
    if (!reduced) {
      gsap
        .timeline({ delay: 0.15 })
        .add(liftText('#evidence-title'))
        .from(
          '.evidence .scene__lede, .evidence__mode, .evidence .scene__note, .evidence__panel',
          {
            autoAlpha: 0,
            y: 12,
            duration: 0.8,
            ease: 'power3.out',
            stagger: 0.06,
          },
          '-=0.75',
        )
        .add(restartAutoplay);
    }
  }
</script>
